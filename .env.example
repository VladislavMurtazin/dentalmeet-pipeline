APOLLO_KEY=        # optional; if empty, research.py reads data/leads.csv instead
GEMINI_KEY=        # optional / reserved
GOOGLE_SERVICE_ACCOUNT=   # optional; JSON string of service account; if empty use local service_account.json
SHEET_NAME=Pilot CRM
WORKSHEET_NAME=Agencies
# Zoho Mail SMTP (cold / transactional send) + warmup IMAP login
# Preferred: CSV lists (order must match). Optional per-account overrides also work:
#   ZOHO_HELLO_PASSWORD=...  ZOHO_VLAD_PASSWORD=...  (see data/accounts.json password_env)
SMTP_ACCOUNTS=hello@dentalmeet.agency,vlad@dentalmeet.agency,outreach@dentalmeet.agency,founder@dentalmeet.agency,vladislav@dentalmeet.agency
SMTP_APP_PASSWORDS=app_pass_1,app_pass_2,app_pass_3,app_pass_4,app_pass_5
IMAP_SERVER=imap.zoho.com
IMAP_PORT=993
# Optional single-account aliases:
# ZOHO_EMAIL=
# ZOHO_APP_PASSWORD=
# Google Workspace backup — either CSV lists OR numbered secrets:
#   GOOGLE_SMTP_1 / GOOGLE_SMTP_2 / GOOGLE_SMTP_3  → vladislav / founder / outreach @meet-agency.com
GOOGLE_SMTP_ACCOUNTS=vladislav@meet-agency.com,founder@meet-agency.com,outreach@meet-agency.com
GOOGLE_SMTP_APP_PASSWORDS=
GOOGLE_SMTP_1=
GOOGLE_SMTP_2=
GOOGLE_SMTP_3=
# Ops Gmail (optional extra reply inbox; still scanned by replies job)
GMAIL_EMAIL=
GMAIL_APP_PASSWORD=
GMAIL_TOKEN_FILE=gmail_token.json
GMAIL_CLIENT_SECRETS=client_secrets.json
# Warmup: 0 = only between our own accounts (no external / clients)
WARMUP_EXTERNAL_RATIO=0
CALENDLY_URL=https://calendly.com/dentalmeet-agency/new-meeting/
PRESENTATION_URL=https://canva.link/n4hed1htcuepmq5
BRIEF_FORM_URL=https://docs.google.com/forms/d/1-_DIAdCf2sqlhcwnUWsAYYKfAb2ibUddOhKwUCA5W_k/viewform
FORM_RESPONSES_SPREADSHEET=Pilot CRM
FORM_RESPONSES_WORKSHEET=Ответы на форму
TRC20_WALLET_ADDRESS=
USDT_WALLET_ADDRESS=          # alias for TRC20_WALLET_ADDRESS
USDT_WALLET_TRC20=            # alias for TRC20_WALLET_ADDRESS
PAYMENT_MIN_USDT=150   # fallback min; mark_paid uses invoice amount when available
CRM_PASSWORD=                 # Basic Auth / session password for /crm (set on Vercel)
CRM_ACCESS_TOKEN=             # optional ?token= alternative for /crm
GEMINI_KEY=          # optional; used by draft_reply (else template fallback)
OAUTH_REDIRECT_URI=http://localhost:8000/oauth/callback
OAUTH_CLIENT_ID=     # or leave empty to read from client_secrets.json
OAUTH_CLIENT_SECRET=
OAUTH_STATE_SECRET=  # random string for CSRF state HMAC
TOKEN_ENCRYPTION_KEY=  # Fernet key or passphrase for tokens/*.json.enc
CALENDLY_API_TOKEN=  # optional; else Google Calendar is used
ALERT_EMAIL=                  # personal Gmail for pipeline alerts
ALERT_FROM_EMAIL=vladislav@dentalmeet.agency
DASHBOARD_URL=https://dentalmeet.agency/dashboard
# Optional: IMAP on alert inbox for deliverability spam detection
ALERT_IMAP_SERVER=imap.gmail.com
ALERT_IMAP_EMAIL=
ALERT_IMAP_PASSWORD=
# Daily multi-account deliverability probes (06:00 UTC cron)
DELIVERABILITY_TEST_EMAIL=          # dedicated Gmail (or reuse ALERT_EMAIL)
DELIVERABILITY_TEST_PASSWORD=       # Gmail app password
# Optional Sunday multi-provider deep check
DELIVERABILITY_OUTLOOK_EMAIL=
DELIVERABILITY_OUTLOOK_PASSWORD=
DELIVERABILITY_YAHOO_EMAIL=
DELIVERABILITY_YAHOO_PASSWORD=
# Email validation (ZeroBounce) — recommended before cold sends; Apollo verified skips credits
ZEROBOUNCE_API_KEY=
